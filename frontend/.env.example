# Copy to .env.local only if you need a different value. Never commit .env files.
# Base path of the ICD API as seen by the browser. Keep it on the dashboard's own origin:
# the Vite dev server (npm run dev) and nginx (Docker) both proxy /api to the backend,
# so no CORS is needed (docs/auth-and-threat-model.md A2.14).
VITE_API_BASE_URL=/api
