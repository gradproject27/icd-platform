{
  "$defs": {
    "TokenUsage": {
      "additionalProperties": false,
      "properties": {
        "completion_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Generated tokens, if known.",
          "title": "Completion Tokens"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prompt tokens, if known.",
          "title": "Prompt Tokens"
        }
      },
      "title": "TokenUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One model run for one evidence package, as the cluster writes it.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Why the run failed (for example out of GPU memory).",
      "title": "Error"
    },
    "finished_at": {
      "description": "End of inference, UTC.",
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "format": {
      "const": "icd-hpc-output-v1",
      "description": "File format and version.",
      "title": "Format",
      "type": "string"
    },
    "generated_by": {
      "description": "Where the model ran.",
      "enum": [
        "hpc",
        "local"
      ],
      "title": "Generated By",
      "type": "string"
    },
    "incident_id": {
      "description": "Copied from the package.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Incident Id",
      "type": "string"
    },
    "model_id": {
      "description": "Pinned model, <repo>@<commit> or the served name.",
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "package_id": {
      "description": "The evidence package this run answers.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Package Id",
      "type": "string"
    },
    "prompt_version": {
      "description": "Prompt version the runner sent.",
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "raw_output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The model's answer exactly as returned; null when error is set.",
      "title": "Raw Output"
    },
    "settings": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Generation settings used, for example temperature and max_new_tokens.",
      "title": "Settings",
      "type": "object"
    },
    "started_at": {
      "description": "Start of inference, UTC.",
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/TokenUsage",
      "description": "Token counts, if known."
    }
  },
  "required": [
    "format",
    "package_id",
    "incident_id",
    "generated_by",
    "model_id",
    "prompt_version",
    "started_at",
    "finished_at"
  ],
  "title": "HpcOutput",
  "type": "object"
}
