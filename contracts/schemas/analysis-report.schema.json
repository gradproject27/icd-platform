{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "One suspicious behaviour with its evidence (FR-14, FR-15).",
      "properties": {
        "category": {
          "$ref": "#/$defs/FindingCategory",
          "description": "Evidence-supported, likely or hypothesis."
        },
        "cited_event_ids": {
          "description": "Evidence event IDs. At least one for evidence_supported (FR-15).",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "title": "Cited Event Ids",
          "type": "array"
        },
        "statement": {
          "description": "The finding.",
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "category",
        "cited_event_ids"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingCategory": {
      "description": "How strongly a finding is supported (FR-15).",
      "enum": [
        "evidence_supported",
        "likely_interpretation",
        "hypothesis"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "SequenceStep": {
      "additionalProperties": false,
      "description": "One step of the possible sequence of events.",
      "properties": {
        "cited_event_ids": {
          "description": "Evidence event IDs that support the step.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Cited Event Ids",
          "type": "array"
        },
        "description": {
          "description": "What happened in this step.",
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "order": {
          "description": "Position in the sequence: 1, 2, 3, ... with no gaps.",
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "order",
        "description",
        "cited_event_ids"
      ],
      "title": "SequenceStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The AI's structured result for one incident. null in a section means not determined.",
  "properties": {
    "attack_type": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Suspected attack type or category; null = not determined.",
      "title": "Attack Type"
    },
    "confidence": {
      "description": "Computed by the analysis component from grounding and evidence completeness, not by the model (OD-16). The mock sets 0.0.",
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "evidence_package_id": {
      "description": "The EvidencePackage the report came from.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Evidence Package Id",
      "type": "string"
    },
    "findings": {
      "description": "Suspicious behaviour with evidence; empty when there is no evidence.",
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "description": "When the report was produced, UTC.",
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "generated_by": {
      "description": "Analyzer backend.",
      "enum": [
        "mock",
        "hpc",
        "local"
      ],
      "title": "Generated By",
      "type": "string"
    },
    "impact": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Possible impact; null = not determined.",
      "title": "Impact"
    },
    "incident_id": {
      "description": "ID of the analysed incident.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Incident Id",
      "type": "string"
    },
    "model_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pinned model name; null for the mock.",
      "title": "Model Id"
    },
    "model_self_rating": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The model's own rating. Stored, never used for the 0.75 gate (OD-16).",
      "title": "Model Self Rating"
    },
    "prompt_version": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Prompt version; null for the mock.",
      "title": "Prompt Version"
    },
    "recommendations": {
      "description": "Free text for the analyst. Never drives an action (C-10).",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "report_id": {
      "description": "Unique report ID.",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Report Id",
      "type": "string"
    },
    "risk_justification": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Explains the deterministic score; the report has no score (FR-19). null = not determined.",
      "title": "Risk Justification"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "description": "Contract version.",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SequenceStep"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Possible sequence of events; null = not determined.",
      "title": "Sequence"
    },
    "summary": {
      "description": "Concise summary (FR-14).",
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "uncertainty": {
      "description": "Uncertainty and limitations (FR-15).",
      "minLength": 1,
      "title": "Uncertainty",
      "type": "string"
    },
    "weaknesses": {
      "anyOf": [
        {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Weaknesses, only when the evidence supports them; null = not determined.",
      "title": "Weaknesses"
    }
  },
  "required": [
    "report_id",
    "incident_id",
    "evidence_package_id",
    "generated_at",
    "generated_by",
    "summary",
    "findings",
    "recommendations",
    "uncertainty",
    "confidence"
  ],
  "title": "AnalysisReport",
  "type": "object"
}
