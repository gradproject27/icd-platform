{
  "$defs": {
    "AnalysisOutcome": {
      "additionalProperties": false,
      "description": "Result of a finished analysis job. An invalid report is a result, not a job failure.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set exactly when report_valid.",
          "title": "Confidence"
        },
        "evidence_package_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Evidence Package Id",
          "type": "string"
        },
        "generated_by": {
          "enum": [
            "mock",
            "hpc",
            "local"
          ],
          "title": "Generated By",
          "type": "string"
        },
        "incident_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "title": "Incident Id",
          "type": "string"
        },
        "problems": {
          "description": "Why the report is not valid; empty when it is.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Problems",
          "type": "array"
        },
        "report_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set exactly when report_valid.",
          "title": "Report Id"
        },
        "report_valid": {
          "description": "True when the report passed every check.",
          "title": "Report Valid",
          "type": "boolean"
        }
      },
      "required": [
        "incident_id",
        "evidence_package_id",
        "generated_by",
        "report_valid"
      ],
      "title": "AnalysisOutcome",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode",
          "description": "Machine-readable reason."
        },
        "message": {
          "description": "Plain-language reason, safe to show to the user.",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "ErrorCode": {
      "description": "Machine-readable reason. The first group answers a request; the second fails a job.",
      "enum": [
        "validation_error",
        "dataset_unknown",
        "file_empty",
        "file_too_large",
        "format_not_accepted",
        "invalid_evidence",
        "not_found",
        "report_not_available",
        "no_parser",
        "parse_failed",
        "counts_mismatch",
        "storage_failed",
        "worker_lost",
        "unmasked_evidence",
        "hpc_unreachable",
        "hpc_timeout",
        "hpc_job_failed",
        "report_missing",
        "internal_error"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "IntakeCounts": {
      "additionalProperties": false,
      "description": "C2's intake summary. No record disappears: every record read is stored or quarantined.",
      "properties": {
        "events_stored": {
          "minimum": 0,
          "title": "Events Stored",
          "type": "integer"
        },
        "flagged": {
          "minimum": 0,
          "title": "Flagged",
          "type": "integer"
        },
        "quarantined": {
          "minimum": 0,
          "title": "Quarantined",
          "type": "integer"
        },
        "quarantined_by_reason": {
          "description": "Quarantined records grouped by reason code.",
          "patternProperties": {
            "^[a-z0-9_]+$": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "propertyNames": {
            "maxLength": 64,
            "minLength": 1
          },
          "title": "Quarantined By Reason",
          "type": "object"
        },
        "records_read": {
          "minimum": 0,
          "title": "Records Read",
          "type": "integer"
        },
        "unflagged": {
          "minimum": 0,
          "title": "Unflagged",
          "type": "integer"
        },
        "unlabelled": {
          "minimum": 0,
          "title": "Unlabelled",
          "type": "integer"
        }
      },
      "required": [
        "records_read",
        "events_stored",
        "flagged",
        "unflagged",
        "unlabelled",
        "quarantined"
      ],
      "title": "IntakeCounts",
      "type": "object"
    },
    "JobKind": {
      "enum": [
        "ingest",
        "analysis"
      ],
      "title": "JobKind",
      "type": "string"
    },
    "JobStage": {
      "description": "What a running job is doing now, for progress display. Set only while running.",
      "enum": [
        "validating",
        "parsing",
        "storing",
        "submitting",
        "waiting_hpc",
        "collecting"
      ],
      "title": "JobStage",
      "type": "string"
    },
    "JobState": {
      "description": "Where a job is. done and failed are final; a job never stays running forever.",
      "enum": [
        "queued",
        "running",
        "done",
        "failed"
      ],
      "title": "JobState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "GET /jobs/{job_id}. Poll it about once a second until state is done or failed.",
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/AnalysisOutcome"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Analysis jobs: set exactly when done."
    },
    "attempts": {
      "description": "Runs so far; a lost worker's job is retried.",
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "counts": {
      "anyOf": [
        {
          "$ref": "#/$defs/IntakeCounts"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ingest jobs: progress while running, final when done, null otherwise."
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiError"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set exactly when failed."
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set when done or failed.",
      "title": "Finished At"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "title": "Job Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/JobKind"
    },
    "max_attempts": {
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobStage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set exactly while running."
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "First time it ran.",
      "title": "Started At"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    },
    "upload_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set exactly for ingest jobs.",
      "title": "Upload Id"
    }
  },
  "required": [
    "job_id",
    "kind",
    "state",
    "created_at",
    "attempts",
    "max_attempts"
  ],
  "title": "Job",
  "type": "object"
}
