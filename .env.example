# Copy to .env and change the values. Never commit .env.
# These are local development values only, not real secrets.

POSTGRES_USER=icd
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=icd

# Old adapter setting (app/llm/adapter.py), not the analysis model: leave it as mock.
# The analysis job's model is ICD_ANALYSIS_BACKEND below.
LLM_BACKEND=mock

# Model for the AI analysis job that runs after every upload (C1 decision F3):
#   stub         no model; deterministic [STUB] reports (default, CI, demos without a model)
#   openai_http  an OpenAI-compatible endpoint: Ollama on a laptop or the faculty cluster's
#                service through its SSH tunnel (docs/ai1-runbook.md section 3)
#   hpc_batch    Slurm batch jobs over ssh (tools/c1/icd_analyze.sbatch); not yet run on a real HPC
#   replay       the 27B model's answers recorded for the demo files, replayed through the normal
#                checks when the cluster is unreachable (docs/ai1-demo-replay.md)
ICD_ANALYSIS_BACKEND=stub
# openai_http (from inside the worker container, the host is host.docker.internal):
ICD_LLM_ENDPOINT=
ICD_LLM_MODEL=
ICD_LLM_SITE=local
# Put the cluster key in your shell or .env only; never commit it.
ICD_LLM_API_KEY=
ICD_LLM_NO_THINKING=
# hpc_batch:
ICD_HPC_SSH_TARGET=
ICD_HPC_SSH_KEY=
ICD_HPC_REMOTE_DIR=
ICD_HPC_SBATCH_SCRIPT=
ICD_HPC_MODEL=
# replay: comma-separated recordings inside the container; empty = all of app/analysis/replay_data
ICD_REPLAY_FILES=

# Largest accepted upload in MB (docs/api-upload-jobs.md). nginx allows up to 512.
MAX_UPLOAD_MB=512

# Development identity for analyst decisions until login exists (C5, T2-15). The dashboard's
# decisions are recorded as this user. Leave empty to refuse every decision with 403.
ICD_DEV_USER=analyst-dev
ICD_DEV_ROLE=soc_analyst

# Host ports (change if 8000 or 8080 are already in use on your machine)
API_PORT=8000
WEB_PORT=8080
