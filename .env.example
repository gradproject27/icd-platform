# Copy to .env and change the values. Never commit .env.
# These are local development values only, not real secrets.

POSTGRES_USER=icd
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=icd

# LLM backend for incident analysis. Only "mock" exists for now (deterministic, no LLM needed).
LLM_BACKEND=mock

# Largest accepted upload in MB (docs/api-upload-jobs.md). nginx allows up to 512.
MAX_UPLOAD_MB=512

# Host ports (change if 8000 or 8080 are already in use on your machine)
API_PORT=8000
WEB_PORT=8080
